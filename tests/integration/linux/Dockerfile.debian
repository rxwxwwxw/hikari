FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
    bash curl tar python3 iproute2 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace

CMD ["bash", "-c", "bash tests/integration/linux/test-installer.sh && bash tests/integration/linux/test-services.sh"]
