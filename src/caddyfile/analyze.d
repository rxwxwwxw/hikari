module caddyfile.analyze;

// Read-only analysis of a parsed Caddyfile tree: which addresses and listeners it uses,
// which global options affect a new site, whether it is managed by config-management
// tooling, and whether hikari can safely add its own site to it.

import caddyfile.lexer;
import caddyfile.parser;
import std.algorithm : canFind, startsWith;
import std.conv : to;
import std.string : indexOf, lastIndexOf, strip, toLower;

struct SiteAddress {
    string raw;
    string scheme;     // "http", "https" or ""
    string host;       // "" = any host
    ushort port;       // 0 = unknown (placeholder)
    string path;
    bool placeholder;  // contains {$ENV}
    bool unsupported;  // unix sockets etc.
    string file;
    uint line;
    string[] binds;    // from `bind` in the site body (incl. snippet imports); empty = default
}

struct GlobalOptions {
    bool present;
    string admin = "localhost:2019"; // "off" or an address
    string autoHttps;                // "", "off", "disable_redirects", "disable_certs", "ignore_loaded_certs"
    ushort httpPort = 80;
    ushort httpsPort = 443;
    string[] defaultBind;
    string[] serversListeners;       // args of `servers` options
    bool hasStorage;
    string email;
}

struct Conflict {
    string kind;    // "listener", "duplicate_site", "global_port", "servers_option"
    string detail;
    string file;
    uint line;
}

struct ImportSummary {
    string file;
    uint line;
    string pattern;
    bool topLevel;
    bool isGlob;
    bool isSnippet;
}

struct CaddyfileReport {
    string path;
    bool parsed;
    string parseError;
    bool hasBom;
    bool crlf;
    GlobalOptions globals;
    SiteAddress[] sites;
    string[] snippetNames;
    ImportSummary[] imports;
    ImportIssue[] importIssues;
    string configManagement;   // non-empty when a managed-by marker is found
    int hikariMarkers;         // count of BEGIN hikari markers in the main file
    string[] placeholderAddresses;
    size_t filesRead;
    string[] hikariSiteFiles;  // imported files written by hikari (excluded from conflicts)
    bool bracelessSite;        // main file is a single site block without braces
}

// ---------------------------------------------------------------------------
// Address parsing (subset of Caddy's ParseAddress needed for listener analysis)
// ---------------------------------------------------------------------------

SiteAddress parseSiteAddress(string raw, const GlobalOptions g) @safe {
    SiteAddress a;
    a.raw = raw;
    string s = raw;
    if (s.indexOf("{$") >= 0) a.placeholder = true;
    if (s.startsWith("unix/") || s.startsWith("unix+h2c/") || s.startsWith("unixgram/")) {
        a.unsupported = true;
        return a;
    }
    auto schemeSep = s.indexOf("://");
    if (schemeSep >= 0) {
        a.scheme = s[0 .. schemeSep].toLower();
        s = s[schemeSep + 3 .. $];
    }
    auto slash = s.indexOf('/');
    if (slash >= 0) {
        a.path = s[slash .. $];
        s = s[0 .. slash];
    }
    string portStr;
    if (s.startsWith("[")) {
        auto close = s.indexOf(']');
        if (close > 0) {
            a.host = s[1 .. close];
            if (close + 1 < s.length && s[close + 1] == ':') portStr = s[close + 2 .. $];
        } else {
            a.host = s;
        }
    } else {
        auto colon = s.lastIndexOf(':');
        if (colon >= 0) {
            a.host = s[0 .. colon];
            portStr = s[colon + 1 .. $];
        } else {
            a.host = s;
        }
    }
    a.host = a.host.toLower();
    if (portStr.length > 0) {
        if (portStr.indexOf("{$") >= 0) {
            a.placeholder = true;
        } else {
            try {
                a.port = to!ushort(portStr);
            } catch (Exception) {
                a.unsupported = true;
            }
        }
    } else if (!a.placeholder || a.host.indexOf("{$") < 0) {
        if (a.scheme == "http") a.port = g.httpPort;
        else a.port = g.httpsPort; // https:// or no scheme -> HTTPS port
    }
    return a;
}

// ---------------------------------------------------------------------------
// Analysis
// ---------------------------------------------------------------------------

private immutable string[] cmMarkers = [
    "ansible managed", "managed by ansible", "managed by puppet", "puppet managed",
    "managed by chef", "chef managed", "generated by chef", "managed by salt", "salt managed",
    "this file is managed by", "do not edit", "generated by nixos", "managed by nix",
];

enum HIKARI_BEGIN_PREFIX = "BEGIN hikari";
enum HIKARI_SITE_PREFIX = "# Managed by hikari:";

private GlobalOptions readGlobals(const ServerBlock[] blocks) @safe {
    GlobalOptions g;
    foreach (b; blocks) {
        if (b.kind != BlockKind.global) continue;
        g.present = true;
        foreach (d; b.body) {
            switch (d.name) {
                case "admin":
                    g.admin = d.args.length > 0 ? d.args[0] : "localhost:2019";
                    break;
                case "auto_https":
                    g.autoHttps = d.args.length > 0 ? d.args[0] : "";
                    break;
                case "http_port":
                    if (d.args.length > 0) try { g.httpPort = to!ushort(d.args[0]); } catch (Exception) {}
                    break;
                case "https_port":
                    if (d.args.length > 0) try { g.httpsPort = to!ushort(d.args[0]); } catch (Exception) {}
                    break;
                case "default_bind":
                    g.defaultBind = d.args.dup;
                    break;
                case "servers":
                    g.serversListeners ~= d.args.length > 0 ? d.args : ["*"];
                    break;
                case "storage":
                    g.hasStorage = true;
                    break;
                case "email":
                    if (d.args.length > 0) g.email = d.args[0];
                    break;
                default:
                    break;
            }
        }
    }
    return g;
}

/// Collects `bind` arguments from a site body, expanding snippet imports (one level deep
/// per call, recursively with a guard).
private string[] collectBinds(const Directive[] body, ref CaddyConfigTree tree, uint depth = 0) @safe {
    string[] binds;
    if (depth > 8) return binds;
    foreach (d; body) {
        if (d.name == "bind") binds ~= d.args;
        if (d.name == "import" && d.args.length > 0) {
            if (auto sn = d.args[0] in tree.snippets) binds ~= collectBinds(sn.body, tree, depth + 1);
            else {
                foreach (f; tree.included) {
                    // in-block file import parsed as a directive file
                    if (f.blocks.length == 1 && f.blocks[0].keys.length == 0 && f.blocks[0].kind == BlockKind.snippet) {
                        import std.path : baseName, globMatch;
                        if (globMatch(baseName(f.path), baseName(d.args[0]))) binds ~= collectBinds(f.blocks[0].body, tree, depth + 1);
                    }
                }
            }
        }
    }
    return binds;
}

CaddyfileReport analyzeTree(ref CaddyConfigTree tree) @safe {
    CaddyfileReport r;
    r.path = tree.main.path;
    r.parsed = true;
    r.hasBom = tree.main.lex.hasBom;
    r.crlf = tree.main.lex.crlf;
    r.filesRead = 1 + tree.included.length;

    auto blocks = tree.allBlocks();
    r.globals = readGlobals(tree.main.blocks);

    bool[string] ownFiles;
    foreach (f; tree.included) {
        auto t = f.src.startsWith("\xEF\xBB\xBF") ? f.src[3 .. $] : f.src;
        if (t.startsWith(HIKARI_SITE_PREFIX)) {
            ownFiles[f.path] = true;
            r.hikariSiteFiles ~= f.path;
        }
    }

    foreach (b; tree.main.blocks) if (b.kind == BlockKind.site && !b.braced) r.bracelessSite = true;

    foreach (b; blocks) {
        if ((b.file in ownFiles) !is null) continue;
        if (b.kind == BlockKind.snippet && b.keys.length == 1) r.snippetNames ~= b.keys[0][1 .. $ - 1];
        if (b.kind != BlockKind.site) continue;
        auto binds = collectBinds(b.body, tree);
        foreach (k; b.keys) {
            auto a = parseSiteAddress(k, r.globals);
            a.file = b.file;
            a.line = b.line;
            a.binds = binds.length > 0 ? binds : r.globals.defaultBind.dup;
            if (a.placeholder) r.placeholderAddresses ~= k;
            r.sites ~= a;
        }
    }

    void addImports(const ParsedFile pf) {
        foreach (imp; pf.imports) {
            bool snippet = (imp.pattern in tree.snippets) !is null;
            bool glob = imp.pattern.canFind('*') || imp.pattern.canFind('?') || imp.pattern.canFind('[');
            r.imports ~= ImportSummary(pf.path, imp.line, imp.pattern, imp.topLevel, glob, snippet);
        }
    }
    addImports(tree.main);
    foreach (f; tree.included) addImports(f);
    r.importIssues = tree.issues.dup;

    foreach (cm; tree.main.lex.comments) {
        auto low = cm.text.toLower();
        if (cm.text.strip().startsWith(HIKARI_BEGIN_PREFIX)) r.hikariMarkers++;
        if (r.configManagement.length == 0 && cm.line <= 15) {
            foreach (m; cmMarkers) {
                if (low.canFind(m)) {
                    r.configManagement = cm.text.strip();
                    break;
                }
            }
        }
    }
    return r;
}

/// Loads and analyses a Caddyfile; parse failures are reported, not thrown.
CaddyfileReport analyzeCaddyfile(string path, FileReader reader = null, GlobLister lister = null) @safe {
    try {
        auto tree = loadCaddyConfig(path, reader, lister);
        return analyzeTree(tree);
    } catch (CaddyfileSyntaxError e) {
        CaddyfileReport r;
        r.path = path;
        r.parsed = false;
        r.parseError = e.msg;
        return r;
    }
}

private bool bindCovers(const string[] binds, string ip) pure @safe {
    if (binds.length == 0) return true; // all interfaces
    foreach (b; binds) {
        string h = b;
        // bind may carry a network prefix like tcp4/ or a port-less address
        auto slash = h.indexOf('/');
        if (slash >= 0 && !h.startsWith("[")) h = h[slash + 1 .. $];
        if (h == ip || h == "0.0.0.0" || h == "::" || h == "[::]" || h == "" || h == "*") return true;
    }
    return false;
}

/// Everything that would clash with hikari adding `https://fqdn:port` bound to `ip`.
Conflict[] conflictsWith(const CaddyfileReport r, string fqdn, string ip, ushort port) @safe {
    Conflict[] cs;
    auto lfqdn = fqdn.toLower();
    foreach (s; r.sites) {
        if (s.unsupported || s.placeholder) continue;
        if (s.port != port) continue;
        if (s.host == lfqdn) {
            cs ~= Conflict("duplicate_site", "site " ~ s.raw ~ " already serves " ~ fqdn ~ ":" ~ to!string(port), s.file, s.line);
        } else if (bindCovers(s.binds, ip)) {
            cs ~= Conflict("listener", "site " ~ s.raw ~ " already listens on port " ~ to!string(port), s.file, s.line);
        }
    }
    if (r.globals.httpPort == port) cs ~= Conflict("global_port", "global http_port is " ~ to!string(port), r.path, 0);
    if (r.globals.httpsPort == port) cs ~= Conflict("global_port", "global https_port is " ~ to!string(port), r.path, 0);
    foreach (l; r.globals.serversListeners) {
        if (l == "*" || l.endsWith(":" ~ to!string(port))) {
            cs ~= Conflict("servers_option", "global `servers " ~ l ~ "` options would apply to hikari's listener", r.path, 0);
        }
    }
    return cs;
}

private bool endsWith(string s, string suffix) pure nothrow @safe {
    return s.length >= suffix.length && s[$ - suffix.length .. $] == suffix;
}

/// Listener addresses implied by the parsed sites, in the same form `caddy adapt` uses
/// (":443", "127.0.0.1:9100", "[::1]:8080"); used by the differential test against Caddy.
string[] parserListeners(const CaddyfileReport r) @safe {
    import std.algorithm : sort, uniq;
    import std.array : array;
    string[] ls;
    foreach (s; r.sites) {
        if (s.placeholder || s.unsupported || s.port == 0) continue;
        auto p = to!string(s.port);
        if (s.binds.length == 0) {
            ls ~= ":" ~ p;
        } else {
            foreach (b; s.binds) {
                string h = b;
                auto slash = h.indexOf('/');
                if (slash >= 0 && !h.startsWith("[")) h = h[slash + 1 .. $];
                ls ~= (h.canFind(':') && !h.startsWith("[")) ? "[" ~ h ~ "]:" ~ p : h ~ ":" ~ p;
            }
        }
    }
    sort(ls);
    return ls.uniq.array;
}

struct Verdict {
    bool integrable;
    string reason;           // why not, or "ok"/"already_integrated"
    Conflict[] conflicts;
}

/// Decides whether hikari may add its site to this Caddyfile. Conservative by design:
/// anything uncertain means "use the isolated hikari-caddy instead".
Verdict integrationVerdict(const CaddyfileReport r, string fqdn, string ip, ushort port) @safe {
    Verdict v;
    if (!r.parsed) { v.reason = "parse_error: " ~ r.parseError; return v; }
    if (r.configManagement.length > 0) { v.reason = "config_management: " ~ r.configManagement; return v; }
    if (r.hikariMarkers > 1) { v.reason = "duplicate_hikari_markers"; return v; }
    // Everything after a brace-less site address belongs to that site, so an appended
    // import would become part of it (Caddy rejects that).
    if (r.bracelessSite) { v.reason = "braceless_site_block"; return v; }
    foreach (iss; r.importIssues) {
        v.reason = "import_" ~ iss.problem ~ ": " ~ iss.pattern;
        return v;
    }
    if (r.placeholderAddresses.length > 0) { v.reason = "unresolved_placeholder: " ~ r.placeholderAddresses[0]; return v; }
    if (fqdn.length == 0 || ip.length == 0) { v.reason = "tailscale_identity_unknown"; return v; }
    v.conflicts = conflictsWith(r, fqdn, ip, port);
    if (v.conflicts.length > 0) { v.reason = "conflict: " ~ v.conflicts[0].detail; return v; }
    v.integrable = true;
    v.reason = r.hikariMarkers == 1 ? "already_integrated" : "ok";
    return v;
}
